# Optional deployment infrastructure only. Business settings are managed in Web.
WEB_BIND_IP=0.0.0.0
WEB_PORT=8088
# Original deployments may retain their existing encryption key; new installs generate data/master.key.
APP_ENCRYPTION_KEY=
ADMIN_API_TOKEN=
ALLOW_LEGACY_ADMIN_TOKEN=false
# PyPI index for image builds; leave empty for pypi.org. Set a mirror when downloads time out,
# e.g. https://mirrors.aliyun.com/pypi/simple (no credentials: build args appear in image history).
PIP_INDEX_URL=
# Concurrent alert AI analyses (alert-analysis-worker replicas). Each one calls the model and both MCPs.
AI_ALERT_ANALYSIS_WORKERS=2
